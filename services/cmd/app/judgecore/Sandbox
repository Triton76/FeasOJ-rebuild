FROM alpine:edge

RUN echo "https://dl-cdn.alpinelinux.org/alpine/edge/testing" >> /etc/apk/repositories

# 更新包列表并安装必要的软件
RUN apk update && apk add --no-cache \
    build-base \
    gcc \
    g++ \
    openjdk17 \
    go \
    python3 \
    py3-pip \
    rust \
    cargo \
    php \
    php-cli \
    php-common \
    php-json \
    php-phar \
    php-iconv \
    php-openssl \
    php-mbstring \
    php-tokenizer \
    php-xml \
    php-curl \
    fpc

# 设置工作目录
WORKDIR /workspace

# 清除缓存
RUN apk cache clean

# 设置默认命令
CMD ["sh"]
